# OpenAI-compatible chat completions endpoint (keep API keys server-side)
AI_API_URL=https://router.huggingface.co/v1/chat/completions
AI_API_KEY=replace-with-your-provider-token
AI_MODEL=your-provider/model-name

# Optional: for Vercel deploys, omit this or set NITRO_PRESET=vercel.
# Render's render.yaml sets NITRO_PRESET=node-server.
